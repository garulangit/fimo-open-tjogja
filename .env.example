# Copy to .env.local (local dev) and/or .dev.vars (Wrangler) and fill in the
# values of YOUR Supabase project. Never commit real values.

# Supabase project URL (public).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable (anon) key. Public by design — access is governed by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Supabase service-role key. SECRET: server-side only (account administration,
# private storage, signed URLs). Bypasses RLS. Never commit, never share,
# never put in wrangler.toml.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
